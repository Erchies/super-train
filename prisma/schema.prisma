generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── TABELAS MESTRES ──────────────────────────────────────────────────────────

model Localizacao {
  id           String   @id @default(cuid())
  codigo       String   @unique
  descricao    String
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  materiais    Material[]
  equipamentos Equipamento[]

  @@map("localizacoes")
}

model TUE {
  id           String   @id @default(cuid())
  // numero: 101–125 (SERIE_100) | 226–240 (SERIE_200)
  numero       String   @unique
  // serie: SERIE_100 | SERIE_200
  serie        String
  descricao    String?
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  equipamentosInstalados   Equipamento[]
  movimentacoesEquipamento MovimentacaoEquipamento[]
  viasRelatorioTurno       RelatorioTurnoVia[]
  atendimentosTurno        AtendimentoTurno[]
  falhasNivelC             FalhaNivelC[]
  solicitacoesTorre        SolicitacaoTorreCco[]
  orientacoesContratada    OrientacaoContratada[]
  pendenciasTurno          PendenciaTurno[]

  @@map("tues")
}

// Posicao agora representa os CARROS: MA | MB | RA | RB
model Posicao {
  id           String   @id @default(cuid())
  codigo       String   @unique
  descricao    String
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Mantido para compatibilidade com dados históricos de movimentações
  movimentacoesEquipamento MovimentacaoEquipamento[]
  materiaisPossiveis       MaterialPosicaoPossivel[]
  equipamentosLegados      Equipamento[]              @relation("EquipamentoPosicaoLegada")

  @@map("posicoes")
}

// Posições possíveis por Série + Carro + Nome do Equipamento (tipo/modelo) + Posição.
// Não vinculado a TUE individual — vale para toda a série (SERIE_100 ou SERIE_200).
// O nome do equipamento agrupa por tipo, independente do n° de série.
model PosicaoPossivel {
  id              String   @id @default(cuid())
  nomeEquipamento String   // descricao do equipamento (agrupa por tipo)
  serie           String   // SERIE_100 | SERIE_200
  carro           String   // MA | MB | RA | RB
  posicao         String   // texto livre, ex: "01", "Painel A", "Rack 02"
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@unique([nomeEquipamento, serie, carro, posicao])
  @@map("posicoes_possiveis")
}

model Funcao {
  id           String   @id @default(cuid())
  codigo       String   @unique
  descricao    String
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Mantido para compatibilidade com dados históricos
  movimentacoesEquipamento MovimentacaoEquipamento[]
  equipamentosLegados      Equipamento[]              @relation("EquipamentoFuncaoLegada")

  @@map("funcoes")
}

model Oficina {
  id           String   @id @default(cuid())
  nome         String
  // tipo: INTERNA | EXTERNA | FABRICANTE
  tipo         String
  contato      String?
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  movimentacoesEquipamento MovimentacaoEquipamento[]

  @@map("oficinas")
}

model Atividade {
  id           String   @id @default(cuid())
  codigo       String   @unique
  descricao    String
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  movimentacoesConsumiveis MovimentacaoConsumivel[]

  @@map("atividades")
}

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senhaHash    String
  // perfil: OPERADOR | SUPERVISOR | ADMIN
  perfil       String   @default("OPERADOR")
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  movConsumRealizadas  MovimentacaoConsumivel[]  @relation("MovConsumRealizadoPor")
  movConsumAutorizadas MovimentacaoConsumivel[]  @relation("MovConsumAutorizadoPor")
  movEquipRealizadas   MovimentacaoEquipamento[] @relation("MovEquipRealizadoPor")
  movEquipAutorizadas  MovimentacaoEquipamento[] @relation("MovEquipAutorizadoPor")
  relatoriosTurno      RelatorioTurno[]          @relation("RelatorioTurnoResponsavel")

  @@map("usuarios")
}

// ─── ENTIDADES PRINCIPAIS ─────────────────────────────────────────────────────

model Material {
  id             String  @id @default(cuid())
  codigoTrensurb String  @unique
  descricao      String
  unidade        String
  estoqueMinimo  Float   @default(0)
  quantidadeAtual Float  @default(0)
  localizacaoId  String?
  observacao     String?
  ativo          Boolean @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  localizacao   Localizacao?            @relation(fields: [localizacaoId], references: [id])
  movimentacoes MovimentacaoConsumivel[]
  posicoesPossiveis MaterialPosicaoPossivel[]

  @@map("materiais")
}

model Equipamento {
  id               String   @id @default(cuid())
  numeroSerie      String   @unique
  codigoTrensurb   String
  descricao        String
  // compatibilidade: SERIE_100 | SERIE_200 | AMBAS
  compatibilidade  String
  // status: EM_ESTOQUE | INSTALADO_TUE | AGUARDANDO_REPARO | EM_REPARO | SUCATA
  status           String   @default("EM_ESTOQUE")
  localizacaoId    String?
  tueId            String?
  posicaoId        String?
  funcaoId         String?
  carro            String?  // MA | MB | RA | RB
  posicaoInstalada String?  // texto livre validado via PosicaoPossivel
  observacao       String?
  ativo            Boolean  @default(true)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  localizacao       Localizacao?     @relation(fields: [localizacaoId], references: [id])
  tue               TUE?             @relation(fields: [tueId], references: [id])
  posicaoLegada     Posicao?         @relation("EquipamentoPosicaoLegada", fields: [posicaoId], references: [id])
  funcaoLegada      Funcao?          @relation("EquipamentoFuncaoLegada", fields: [funcaoId], references: [id])
  movimentacoes     MovimentacaoEquipamento[]

  @@map("equipamentos")
}

model MaterialPosicaoPossivel {
  materialId String
  posicaoId  String
  criadoEm   DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  posicao  Posicao  @relation(fields: [posicaoId], references: [id], onDelete: Cascade)

  @@id([materialId, posicaoId])
  @@map("materiais_posicoes_possiveis")
}

// ─── MOVIMENTAÇÕES ────────────────────────────────────────────────────────────

model MovimentacaoConsumivel {
  id            String   @id @default(cuid())
  materialId    String
  // tipo: ENTRADA | SAIDA | AJUSTE_POSITIVO | AJUSTE_NEGATIVO
  tipo          String
  quantidade    Float
  numeroOS      String?
  numeroChamado String?
  atividadeId   String?
  observacao    String?
  ehExcecao     Boolean  @default(false)
  justificativa String?
  autorizadoPor String?
  realizadoPor  String
  realizadoEm  DateTime
  criadoEm     DateTime @default(now())

  material    Material   @relation(fields: [materialId], references: [id])
  atividade   Atividade? @relation(fields: [atividadeId], references: [id])
  usuario     Usuario    @relation("MovConsumRealizadoPor", fields: [realizadoPor], references: [id])
  autorizador Usuario?   @relation("MovConsumAutorizadoPor", fields: [autorizadoPor], references: [id])

  @@map("movimentacoes_consumiveis")
}

model MovimentacaoEquipamento {
  id               String   @id @default(cuid())
  equipamentoId    String
  // tipo: ENTRADA_ESTOQUE | INSTALACAO_TUE | RETIRADA_TUE_ESTOQUE | ...
  tipo             String
  statusAnterior   String?
  statusNovo       String
  localizacaoId    String?
  tueId            String?
  carro            String?  // MA | MB | RA | RB
  posicaoInstalada String?  // texto da posição (novo)
  // Campos legados — mantidos para histórico de movimentações antigas
  posicaoId        String?
  funcaoId         String?
  oficinaId        String?
  motivoReparo     String?
  motivoSucata     String?
  numeroOS         String?
  numeroChamado    String?
  observacao       String?
  ehExcecao        Boolean  @default(false)
  justificativa    String?
  autorizadoPor    String?
  realizadoPor     String
  realizadoEm     DateTime
  criadoEm        DateTime @default(now())

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id])
  tue         TUE?        @relation(fields: [tueId], references: [id])
  posicao     Posicao?    @relation(fields: [posicaoId], references: [id])
  funcao      Funcao?     @relation(fields: [funcaoId], references: [id])
  oficina     Oficina?    @relation(fields: [oficinaId], references: [id])
  usuario     Usuario     @relation("MovEquipRealizadoPor", fields: [realizadoPor], references: [id])
  autorizador Usuario?    @relation("MovEquipAutorizadoPor", fields: [autorizadoPor], references: [id])

  @@map("movimentacoes_equipamentos")
}

// RELATORIO DE TURNO - PLANTAO CORRETIVA SEOFI

model RelatorioTurno {
  id                   String    @id @default(cuid())
  data                 DateTime
  turno                String
  responsavelId        String?
  responsavelNome      String
  equipeTrensurb       String?
  equipeTerceirizada   String?
  condicoesGeraisTurno String?
  observacoesGerais    String?
  status               String    @default("ABERTO")
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt
  fechadoEm            DateTime?
  canceladoEm          DateTime?

  responsavel          Usuario?               @relation("RelatorioTurnoResponsavel", fields: [responsavelId], references: [id])
  vias                 RelatorioTurnoVia[]
  atendimentos         AtendimentoTurno[]
  falhasNivelC         FalhaNivelC[]
  solicitacoesTorre    SolicitacaoTorreCco[]
  orientacoesContratada OrientacaoContratada[]
  pendencias           PendenciaTurno[]

  @@index([data, turno, status])
  @@map("relatorios_turno")
}

model RelatorioTurnoVia {
  id                 String   @id @default(cuid())
  relatorioTurnoId   String
  via                String
  tueId              String?
  tueNumero          String?
  horarioEntrada     DateTime?
  horarioSaida       DateTime?
  motivoPermanencia  String?
  numeroOS           String?
  numeroPI           String?
  numeroTicket       String?
  statusVia          String   @default("LIVRE")
  equipeResponsavel  String?
  observacao         String?
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  relatorioTurno     RelatorioTurno @relation(fields: [relatorioTurnoId], references: [id], onDelete: Cascade)
  tue                TUE?           @relation(fields: [tueId], references: [id])

  @@unique([relatorioTurnoId, via])
  @@index([statusVia])
  @@map("relatorio_turno_vias")
}

model AtendimentoTurno {
  id                    String   @id @default(cuid())
  relatorioTurnoId      String
  tipoRegistro          String
  numeroRegistro        String
  tueId                 String?
  tueNumero             String?
  carro                 String?
  sistema               String?
  equipamento           String?
  sintomaInformado      String
  diagnosticoEncontrado String?
  servicoExecutado      String?
  materialUtilizado     String?
  equipeExecutante      String?
  situacaoFinal         String
  observacaoProximoTurno String?
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  relatorioTurno        RelatorioTurno @relation(fields: [relatorioTurnoId], references: [id], onDelete: Cascade)
  tue                   TUE?           @relation(fields: [tueId], references: [id])

  @@index([relatorioTurnoId, situacaoFinal])
  @@index([numeroRegistro])
  @@map("atendimentos_turno")
}

model FalhaNivelC {
  id                          String    @id @default(cuid())
  relatorioTurnoId            String?
  numeroOS                    String?
  numeroPI                    String?
  numeroTicket                String?
  tueId                       String?
  tueNumero                   String?
  origemFalha                 String
  descricaoFalha              String
  dataAbertura                DateTime
  prioridade                  String
  acaoNecessaria              String?
  necessitaRecolhimento       Boolean   @default(false)
  recolhimentoSolicitado      Boolean   @default(false)
  horarioSolicitacaoTorre     DateTime?
  retornoTorre                String    @default("NAO_SOLICITADO")
  motivoNaoExecucao           String?
  responsavelAcompanhamento   String?
  status                      String    @default("PENDENTE")
  dataConclusao               DateTime?
  observacao                  String?
  criadoEm                    DateTime  @default(now())
  atualizadoEm                DateTime  @updatedAt

  relatorioTurno              RelatorioTurno?      @relation(fields: [relatorioTurnoId], references: [id], onDelete: SetNull)
  tue                         TUE?                 @relation(fields: [tueId], references: [id])
  solicitacoesTorre           SolicitacaoTorreCco[]

  @@index([status, prioridade])
  @@index([tueId])
  @@map("falhas_nivel_c")
}

model SolicitacaoTorreCco {
  id                       String   @id @default(cuid())
  relatorioTurnoId         String
  horarioSolicitacao       DateTime
  tueId                    String?
  tueNumero                String?
  motivoSolicitacao        String
  solicitadoPara           String?
  retorno                  String
  resultado                String
  relacionadoFalhaNivelCId String?
  observacao               String?
  criadoEm                 DateTime @default(now())
  atualizadoEm             DateTime @updatedAt

  relatorioTurno           RelatorioTurno @relation(fields: [relatorioTurnoId], references: [id], onDelete: Cascade)
  tue                      TUE?           @relation(fields: [tueId], references: [id])
  falhaNivelC              FalhaNivelC?   @relation(fields: [relacionadoFalhaNivelCId], references: [id], onDelete: SetNull)

  @@index([retorno, resultado])
  @@map("solicitacoes_torre_cco")
}

model OrientacaoContratada {
  id                         String   @id @default(cuid())
  relatorioTurnoId           String
  horario                    DateTime
  tecnicoOuEquipeOrientada   String
  empresa                    String?
  orientacaoRepassada        String
  motivoOrientacao           String?
  responsavelOrientacao      String
  tueId                      String?
  tueNumero                  String?
  numeroOS                   String?
  retornoContratada          String
  observacao                 String?
  criadoEm                   DateTime @default(now())
  atualizadoEm               DateTime @updatedAt

  relatorioTurno             RelatorioTurno @relation(fields: [relatorioTurnoId], references: [id], onDelete: Cascade)
  tue                        TUE?           @relation(fields: [tueId], references: [id])

  @@index([retornoContratada])
  @@map("orientacoes_contratada")
}

model PendenciaTurno {
  id                 String   @id @default(cuid())
  relatorioTurnoId   String
  prioridade         String
  tueId              String?
  tueNumero          String?
  numeroOS           String?
  numeroPI           String?
  numeroTicket       String?
  pendencia          String
  motivoPendencia    String
  acaoRecomendada    String?
  responsavel        String?
  status             String   @default("PENDENTE")
  observacao         String?
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  relatorioTurno     RelatorioTurno @relation(fields: [relatorioTurnoId], references: [id], onDelete: Cascade)
  tue                TUE?           @relation(fields: [tueId], references: [id])

  @@index([status, prioridade])
  @@map("pendencias_turno")
}
