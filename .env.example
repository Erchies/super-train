# Supabase pooled connection string for the application runtime.
# Copy it from Supabase Project Settings > Database > Connection string > Transaction pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Supabase direct connection string used by Prisma migrations.
# Copy it from Supabase Project Settings > Database > Connection string > Direct connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Local NextAuth URL. In production, use your Vercel URL, for example:
# NEXTAUTH_URL="https://seu-projeto.vercel.app"
NEXTAUTH_URL="http://localhost:3000"

# Generate a strong secret before deploying.
# Example: openssl rand -base64 32
NEXTAUTH_SECRET="troque_por_uma_chave_segura"

# Optional seed passwords. Set these in production before running the seed.
# ADMIN_PASSWORD=""
# SUPERVISOR_PASSWORD=""
# OPERADOR_PASSWORD=""
